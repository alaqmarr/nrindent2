generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // ADMIN, MANAGER, EDITOR
  phone        String?
  avatar       String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  shortDescription String?
  description      String?
  image            String?
  bannerImage      String?
  featured         Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  products         Product[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  sku              String?
  shortDescription String?
  description      String
  image            String?
  gallery          String    @default("[]") // JSON array of image URLs
  specifications   String    @default("[]") // JSON array of { label: string, value: string }
  features         String    @default("[]") // JSON array of strings
  applications     String    @default("[]") // JSON array of strings
  priceLabel       String?   @default("Request a Quote")
  minOrderQty      String?   @default("1 Unit")
  unit             String?   @default("Piece")
  inStock          Boolean   @default(true)
  featured         Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  brochureUrl      String?
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inquiries        Inquiry[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Inquiry {
  id          String   @id @default(cuid())
  type        String   @default("PRODUCT_EMAIL") // PRODUCT_EMAIL, PRODUCT_WHATSAPP, CONTACT_FORM
  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  message     String
  quantity    String?
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  productSku  String?
  status      String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED, ARCHIVED
  adminNotes  String?
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

